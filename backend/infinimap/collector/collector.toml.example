# infinimap collector configuration EXAMPLE.

# PostgreSQL libpq connection string.
# default: "postgresql:///infinimap"
dsn = "postgresql:///infinimap"

# Logical fabric name. Resolved to a fabric_id, created on first sight.
# default: "default"
fabric = "default"

# IB subnet prefix, stamped on the fabric row at first creation only.
# Leave commented to store no prefix (the default).
# subnet_prefix = "0xfe80000000000000"

# Topology poll cadence in seconds (loop mode). default: 300
interval_s = 300

# Read the three records from a fixture directory instead of live saquery. Leave
# commented for production (live saquery). default: unset
# from_dir = "../test_data/data"

# Traffic sweep cadence in seconds. A separate, cheaper poll than the topology
# cycle above - ibqueryerrors --counters reports every port unconditionally, so
# it needs no port universe and can run far more often.
# default: 30
# traffic_interval_s = 30

# Every setting above can also come from the environment, which overrides this
# file: INFINIMAP_DSN, INFINIMAP_FABRIC, INFINIMAP_INTERVAL,
# INFINIMAP_TRAFFIC_INTERVAL.
